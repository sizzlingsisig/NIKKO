# Form5 Portal — environment template
# Copy to .env (gitignored — never commit real values):
#   cp .env.example .env
# Generate a real admin token with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"

# ─── API ────────────────────────────────────────────────────────────
# Admin routes check: Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=change-me

# SQLite lives in the compose volume (form5-data → /data)
DATABASE_URL=sqlite:////data/registrations.db

# Browser origins allowed to call the API (comma separated).
# CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost

# Per-artifact upload ceilings in megabytes (PRD §6).
# Raise these ONLY together — the frontend constants
# MAX_PDF_BYTES / MAX_IMAGE_BYTES in src/domain/validation.ts must match, or
# the browser will accept a file the API answers 413 to.
# PDF_MAX_MB=10
# IMAGE_MAX_MB=5

# ─── Object storage (PRD FR-5: S3-compatible) ───────────────────────
# Garage (S3-compatible) — the same engine in dev and prod.
# From INSIDE compose the hostname is the service name (garage) on its
# internal port 3900. From your host it's http://localhost:9100.
# The API signs with S3_REGION, which must match s3_region in
# garage/garage.toml ("garage").
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=org-roster-dev
S3_ACCESS_KEY_ID=form5portalaccess
S3_SECRET_ACCESS_KEY=form5portaldevsecret

# Host-side runs (uvicorn without compose) use the app's built-in dev
# defaults, which point at http://localhost:9100 with the same keys —
# no .env needed to try the API locally.

# Prod: a real deployment — same values, different endpoint/keys/region
# (e.g. a Garage instance on a VPS behind TLS, or any S3-compatible
# provider). Flip the env, no code change.
# S3_ENDPOINT=https://s3.your-domain.com
# S3_REGION=garage
# S3_BUCKET=org-roster
# S3_ACCESS_KEY_ID=<access-key-id>
# S3_SECRET_ACCESS_KEY=<access-key-secret>
