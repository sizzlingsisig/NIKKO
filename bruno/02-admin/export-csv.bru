meta {
  name: Export deduped roster CSV (FR-4.4)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/admin/export.csv
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

tests {
  test("sends a CRLF, fully-quoted CSV as an attachment", function() {
    expect(res.status).to.equal(200);
    expect(res.headers["content-disposition"]).to.include("upv_roster_deduplicated.csv");
    const firstLine = res.body.split("\r\n")[0];
    expect(firstLine).to.equal(
      '"id","student_number","full_name","degree_program","college","year_level","up_mail","submitted_at"'
    );
  });
}
