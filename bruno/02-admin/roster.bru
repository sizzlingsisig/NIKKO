meta {
  name: Roster with dedupe badges (FR-4.3)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/admin/roster
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

tests {
  test("flags exactly one exported row per student", function() {
    expect(res.status).to.equal(200);
    expect(res.body.rows).to.be.an("array");
    const exportedPerStudent = {};
    for (const row of res.body.rows) {
      if (!row.exported) continue;
      exportedPerStudent[row.student_number] = (exportedPerStudent[row.student_number] || 0) + 1;
    }
    for (const n of Object.values(exportedPerStudent)) {
      expect(n).to.equal(1);
    }
  });
}
